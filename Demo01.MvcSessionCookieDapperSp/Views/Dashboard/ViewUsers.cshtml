@model List<Demo01.MvcSessionCookieDapperSp.ViewModels.ReportingUserViewModel>

@{
    ViewData["Title"] = "View Users";
}

<h2>Reporting Users</h2>

<a asp-controller="Dashboard" asp-action="Index">Back to Dashboard</a>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info mt-3">
        No users are directly reporting to you.
    </div>
}
else
{
    <form asp-controller="Dashboard" asp-action="ViewUsers" method="get" class="mb-3">
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">Attendance Date</label>
                <input type="date"
                       name="attendanceDate"
                       value="@ViewBag.AttendanceDate"
                       class="form-control" />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>
            </div>
        </div>
    </form>
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Level</th>
                <th>Login Time</th>
                <th>Logout Time</th>
                <th>Total Minutes</th>
                <th>Net Minutes</th>
                <th>Status</th>
                <th>Current Login</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.DepartmentName</td>
                    <td>@user.DesignationName</td>
                    <td>@user.LevelNo</td>
                    <td>@user.LoginTime</td>
                    <td>@user.LogoutTime</td>
                    <td>@user.TotalDurationMinutes</td>
                    <td>@user.NetDurationMinutes</td>
                    <td>
                        @if (user.IsCurrentlyLoggedIn)
                        {
                            <span class="badge bg-success">Logged In</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Logged Out</span>
                        }
                    </td>

                    <td>@user.CurrentActiveLoginTime</td>
                </tr>
            }
        </tbody>
    </table>
}